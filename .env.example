# ==============================================================================
# HIGHTOWER SERVERS , ENVIRONMENT TEMPLATE
# ==============================================================================
# Copy this file to .env and fill in real values:
#
#   cp .env.example .env
#
# .env is git-ignored and must stay that way , it holds your database password.
# Every variable below is read either by docker-compose.yml, scripts/config.sh,
# or the backend at runtime.

# ── DATABASE (required) ───────────────────────────────────────────────────────
# Host as seen from wherever the backend runs.
# Docker Compose overrides this to 'database' for the container automatically,
# so this value only matters when you run the backend locally with
# `npm run dev:backend` , keep it at 127.0.0.1 for that.
DB_HOST=127.0.0.1

# Used for both the MySQL user and the root password of the database container.
DB_USER=hightower-admin
DB_NAME=hightower
DB_PASSWORD=change-me-to-a-long-random-string

# Host port the MySQL container is published on. The backend also uses this as
# its connection port, so change both sides together if you move it.
DB_EXPOSE_PORT=3306

# ── PATHS ─────────────────────────────────────────────────────────────────────
# Where scripts/migration.sh looks for .sql files (host path, absolute or
# relative to the project root).
MIGRATIONS_DIR=./backend/src/db/migrations

# Where game image tarballs are saved/loaded from. Defaults to <project>/images.
# IMAGES_DIR=./images

# ── OPTIONAL: ADMIN OVERRIDE ──────────────────────────────────────────────────
# A master password that unlocks any server's management actions, bypassing the
# per-server manager password. Leave unset to disable the override entirely
# (recommended). If you set it, treat it like a root password.
# ADMIN_MASTER_PASSWORD=

# ── OPTIONAL: LIMITS AND TUNING (defaults shown) ──────────────────────────────
# Pino log level: trace | debug | info | warn | error | fatal
# LOG_LEVEL=info

# Largest single file accepted by the file manager, in MB.
# MAX_UPLOAD_FILE_MB=32768

# RAM (MB) kept free for the host , a server that would eat into this margin
# is refused at creation time.
# RAM_SAFETY_MARGIN_MB=512

# Hard cap on how many game servers may exist at once.
# MAX_TOTAL_SERVERS=40

# Rate limit on server creation: at most MAX_SERVERS_WITHIN_WINDOW new servers
# per CREATE_SERVER_WINDOW_MINUTES minutes.
# MAX_SERVERS_WITHIN_WINDOW=1
# CREATE_SERVER_WINDOW_MINUTES=60

# ── NOTE ──────────────────────────────────────────────────────────────────────
# BACKEND_PORT appears in scripts/config.sh, but the backend currently listens
# on a fixed port 4532 (see backend/src/server.ts) and Compose publishes that
# port. The variable only affects informational output in scripts/init.sh.
